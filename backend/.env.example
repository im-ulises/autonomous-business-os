# Only for local CPython testing. Do NOT place these secrets in the Worker bundle.
# Server-side environment variables only. Never expose these to Next.js clients.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/autonomous_os
JWT_ISSUER=https://example.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWT_JWKS_URL=https://example.supabase.co/auth/v1/.well-known/jwks.json
CORS_ORIGINS=http://localhost:3000
# Non-owner PostgreSQL login verified by FastAPI. Must be permitted to SET ROLE autonomous_os_api.
DB_EXPECTED_LOGIN=autonomous_os_login
# Python Workers use bindings HYPERDRIVE + JWT_ISSUER/JWT_AUDIENCE/JWT_JWKS_URL,
# CORS_ORIGINS and DB_EXPECTED_LOGIN, delivered via Cloudflare secrets/vars.
# Never put a DATABASE_URL or a database password in browser JavaScript.
